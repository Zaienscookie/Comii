# 复制为 .env 后按需修改：docker compose up -d --build 会自动读取
# 你的媒体目录（宿主机路径）；容器里统一挂到 /library（只读）
COMII_MEDIA_DIR=./library

# 首次启动创建的 Owner（留空用户名默认 admin，密码留空则随机生成并打印日志）
COMII_OWNER_USER=admin
COMII_OWNER_PASSWORD=

# 服务器访问令牌；留空自动生成并写入 ./data/server.conf
COMII_ACCESS_TOKEN=

# 需要跨域时填写（逗号分隔），默认不允许跨域
COMII_CORS_ORIGINS=
