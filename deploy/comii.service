[Unit]
Description=Comii server (Comic library: WebUI + data API)
After=network.target

[Service]
Type=simple
WorkingDirectory=/root/dev/comii/server
Environment=COMII_LIBRARY=/root/dev/storage/library
Environment=COMII_DATA=/root/dev/storage/data
Environment=COMII_PORT=8000
Environment=COMII_API_PORT=8001
Environment=COMII_LOG_LEVEL=info
ExecStart=/root/dev/runtime/python/bin/python3.11 -m comii.serve
Restart=always
RestartSec=3
User=root

[Install]
WantedBy=multi-user.target
